# ========================================
# SAUCEDEMO TEST AUTOMATION ENVIRONMENT
# ========================================
# Copy this file and create your own .env
# DO NOT commit .env to Git!

# Application Configuration
# ========================================
BASE_URL=https://www.saucedemo.com

# Test User Credentials
# ========================================
STANDARD_USER=standard_user
PASSWORD=secret_sauce

# Additional Test Users (for reference)
LOCKED_OUT_USER=locked_out_user
PROBLEM_USER=problem_user
PERFORMANCE_GLITCH_USER=performance_glitch_user
ERROR_USER=error_user
VISUAL_USER=visual_user

# Browser Configuration
# ========================================
BROWSER=chromium
HEADLESS=false
SLOW_MO=0

# Test Configuration
# ========================================
TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
ACTION_TIMEOUT=10000

# Retry Configuration
# ========================================
RETRIES=0
WORKERS=4

# Report Configuration
# ========================================
GENERATE_REPORT=true
REPORT_PATH=./test-results
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
TRACE_ON_FAILURE=true

# Environment
# ========================================
NODE_ENV=test

# Optional: API Configuration (if needed)
# ========================================
# API_BASE_URL=https://api.saucedemo.com
# API_TIMEOUT=10000

# Optional: Database Configuration (if needed)
# ========================================
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=test_db
# DB_USER=test_user
# DB_PASSWORD=test_password

# Optional: Email Configuration (for reports)
# ========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Optional: Slack Notifications
# ========================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Optional: Custom Configuration
# ========================================
# TEST_DATA_PATH=./test-data
# LOG_LEVEL=info
# PARALLEL_TESTS=true