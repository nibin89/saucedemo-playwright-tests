{
  "name": "saucedemo",
  "version": "1.0.0",
  "description": "E2E Test Automation Framework for SauceDemo using Playwright + JavaScript with POM",
  "main": "index.js",
  "scripts": {
    "test-headed": "playwright test --headed --workers=2",
    "test-non-headed": "playwright test",
    "test-slow": "playwright test --config=playwright.config.ts",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:serve": "allure serve ./allure-results",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky install"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "e2e",
    "pom",
    "ci-cd"
  ],
  "author": "Nibin Mathew",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.3",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^2.15.1",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "husky": "^9.1.7"
  }
}
